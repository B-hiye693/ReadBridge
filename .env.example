# 首次使用按 README.md 的7步教程操作。
# 复制本文件为根目录 .env；只有根目录 .env 是实际配置入口。
# 首次先保留 mock + browser 跑通交互，已有 .env 不要覆盖。
AI_PROVIDER=mock

# 请在阿里云百炼控制台获取并仅填写到本地 .env，禁止提交真实 Key。
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-flash
# 从百炼控制台复制所属地域和业务空间的 OpenAI 兼容 API Host。
QWEN_BASE_URL=
QWEN_TIMEOUT_SECONDS=120
QWEN_MAX_COMPLETION_TOKENS=4200
# 以下性能参数首次使用保持默认。
PERFORMANCE_LOGS=true
EASY_READ_MODE=fast
EASY_READ_MAX_INPUT_CHARS=20000
EASY_READ_MAX_BLOCKS=100
EASY_READ_CACHE_TTL_SECONDS=900
EASY_READ_CACHE_MAX_ENTRIES=64

# 首次语音保持 browser，无需Key；cosyvoice为可选真实语音，见配置手册。
TTS_PROVIDER=browser
TTS_MODEL=cosyvoice-v3-flash
# 可单独配置；留空时 CosyVoice 会复用 QWEN_API_KEY。
TTS_API_KEY=
# 必须填写完整的 CosyVoice HTTP endpoint，不是 OpenAI 兼容地址。
TTS_BASE_URL=
TTS_VOICE=longyingling_v3
TTS_TIMEOUT_SECONDS=60
TTS_AUDIO_FORMAT=mp3
# 仅在所选模型和音色明确支持 instruction 时填写。
TTS_INSTRUCTION=
TTS_CACHE_MAX_ENTRIES=64
TTS_CACHE_MAX_BYTES=33554432
