<Window x:Class="ReadBridge.Desktop.LibraryTrashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文件库回收站" Width="620" Height="480" MinWidth="500" MinHeight="360" WindowStartupLocation="CenterOwner" Background="#F8FBF9">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="文件库回收站" FontSize="22" FontWeight="Bold" Foreground="#244F40"/><TextBlock Text="删除的文件、提取文本和 AI 结果都可在这里恢复。" Foreground="#718078" Margin="0,5,0,12"/></StackPanel>
    <ListBox x:Name="TrashList" Grid.Row="1" BorderBrush="#DCE7E2" Background="White" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="4" BorderBrush="#E1E9E5" BorderThickness="1" CornerRadius="9"><StackPanel><TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" FontSize="15" Foreground="#244F40" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DisplayMeta}" Foreground="#718078" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#718078"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="永久删除" Padding="14,8" Margin="8,0,0,0" Foreground="#B42318" Click="DeletePermanently"/><Button Content="恢复到文件库" Padding="14,8" Margin="8,0,0,0" Background="#347866" Foreground="White" Click="RestoreSelected"/><Button Content="关闭" Padding="14,8" Margin="8,0,0,0" IsCancel="True" Click="CloseWindow"/></StackPanel></DockPanel>
  </Grid>
</Window>
