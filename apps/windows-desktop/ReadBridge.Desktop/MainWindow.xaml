    <Grid x:Name="ContentGrid" Grid.Row="3" Margin="16,14,16,8"><Grid.RowDefinitions><RowDefinition x:Name="OriginalRow" Height="5*"/><RowDefinition x:Name="SplitterRow" Height="8"/><RowDefinition x:Name="ResultRow" Height="5*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition x:Name="OriginalColumn" Width="*"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition x:Name="ResultColumn" Width="0"/></Grid.ColumnDefinitions>
