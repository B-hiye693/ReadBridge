extStep"/><TextBlock x:Name="StepProgressText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#347866" FontWeight="Bold"/></DockPanel></Border></StackPanel></ScrollViewer></Grid></Border>
