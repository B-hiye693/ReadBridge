# 旧路径兼容说明：实际配置请使用项目根目录 .env。
# 首次使用参见 ../../../README.md，完整模板为 ../../../.env.example。
# 下列旧示例不由服务自动加载，请勿在此填写真实Key。
AI_PROVIDER=mock
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_COMPLETION_TOKENS=3000

TTS_PROVIDER=browser
TTS_MODEL=cosyvoice-v3-flash
TTS_API_KEY=
# 示例：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
TTS_BASE_URL=
TTS_VOICE=longyingling_v3
TTS_TIMEOUT_SECONDS=60
TTS_AUDIO_FORMAT=mp3
TTS_INSTRUCTION=
TTS_CACHE_MAX_ENTRIES=64
TTS_CACHE_MAX_BYTES=33554432
